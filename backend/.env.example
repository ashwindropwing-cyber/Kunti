# ─── Server Configuration ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Authentication ──────────────────────────────────────────────────
# Secret key for signing JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_here

# ─── PostgreSQL Database Configuration ──────────────────────────────
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kunti_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# Alternatively, supply a full connection URI (e.g., Supabase / RDS / Render Postgres):
# DATABASE_URL=postgres://postgres:password@localhost:5432/kunti_db

# ─── Cache & Pub/Sub ──────────────────────────────────────────────────
# Redis connection URL (optional)
REDIS_URL=redis://127.0.0.1:6379

# ─── Firebase FCM Push Notifications ONLY ────────────────────────────
# Stringified JSON of the Firebase Admin SDK service account key file for sending push notifications
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# ─── Twilio SMS Integration ───────────────────────────────────────────
SMS_TEST_MODE=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+12345678901

# ─── SMTP Email Integration ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM="Kunti Kolkata Rolls Support" <support@kuntikolkatarolls.com>

# ─── Razorpay Payment Integration ─────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Cloudinary Media Storage ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
