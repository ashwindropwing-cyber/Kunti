# ─── Server Configuration ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development


# ─── Authentication ──────────────────────────────────────────────────
# 32-character secret key for signing JSON Web Tokens
JWT_SECRET=c9ad0ff74a76174a9fc1a085ebec4628c0d71621c57cdee296860fc68e4d576e

# ─── Cache & Pub/Sub ──────────────────────────────────────────────────
# Redis connection URL (e.g., redis://127.0.0.1:6379)
REDIS_URL=redis://127.0.0.1:6379

# ─── Firebase Integration ─────────────────────────────────────────────
# Realtime Database URL
FIREBASE_DATABASE_URL=https://tind-ffb61-default-rtdb.firebaseio.com
# Stringified JSON of the Firebase Admin SDK service account key file.
# Note: Ensure all double quotes are preserved and the entire JSON is single-line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# ─── Twilio SMS Integration ───────────────────────────────────────────
# SMS_TEST_MODE=true prevents actual Twilio API charges and logs OTP to console
SMS_TEST_MODE=true
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12345678901

# ─── SMTP Email Integration ───────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM="Dropwing Support" <support@dropwinggroups.com>

# ─── Google Maps Integration ─────────────────────────────────────────
# Required for geocoding and distance matrices
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Razorpay Payment Integration ─────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PAYOUT_WEBHOOK_SECRET=your_razorpay_payout_webhook_secret
# Razorpay payout source account (use test account ID for dev)
RAZORPAY_ACCOUNT_NUMBER=2323230044556677
RAZORPAY_PAYOUT_MODE=IMPS

# ─── Cloudinary Media Storage ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
